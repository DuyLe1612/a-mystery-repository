# Environment variables template
# Copy this file to .env and fill in your values

# === REQUIRED ===
OPENAI_API_KEY=your_openai_api_key_here

# === SCRAPING ===
COUNT_ARTICLES=30
OUTPUT_DIR=./articles

# === SCHEDULER (for web server mode) ===
SCHEDULE_HOUR=0
SCHEDULE_MINUTE=0

# === LOGGING ===
LOG_LEVEL=INFO
LOG_DIR=./logs
